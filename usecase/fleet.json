{
    "_": [ "  vim: set expandtab shiftwidth=4 softtabstop=4: ",
        "",
        "By default, we use the heimdal KDC implementation and MIT kerberos",
        "everywhere else. The '.fleet.__default__.image' attribute defines the",
        "default image to use across (non-VM) hosts in general, which we set",
        "that to the MIT-specific image. Any '.fleet.<hostname>.image'",
        "attributes will override that for their respective hosts, and we use",
        "this in the cases of 'kdc_primary' and 'kdc_secondary' to force the",
        "use of the heimdal-specific image.",
        "",
        "If you want to switch the KDCs over to use the MIT implementation, you",
        "will also need to;",
        " - Change '.vars.kdcsvc_enable_stateless' to 'false', as the MIT",
        "   implementation doesn't support the required features. (This will",
        "   force explicit registration of the principals in '.principals'.)",
        " - Change '.fleet.kdc_primary.kdcsvc.provider' to 'mit'.",
        " - Change '.defaults.enroll_profile.krb5conf.kdchost' and",
        "   '.defaults.enroll_profile.ktgen.api' to be 'kdc_primary' rather",
        "   than 'kdc_secondary', because we don't yet support the MIT KDC",
        "   replication idiosynchrasies.",
        "",
        "If you want to switch a VM host over to use the heimdal kerberos",
        "implementation, set '.fleet.<hostname>.vm' to 'qemu_heimdal' or",
        "'uml_heimdal', depending on the preferred virtualisation.",
        "",
        "If you want to enable the 'stateless' feature, set",
        "'.vars.kdcsvc_enable_stateless' to 'true'. This presently requires",
        "heimdal on both the KDC and client ends, but should eventually support",
        "mit clients (waiting on a heimdal KDC fix)."
    ],
    "vars": {
        "realm": "HCPHACKING.XYZ",
        "domain": "hcphacking.xyz",
        "kdcsvc_enable_stateless": false
    },
    "defaults": {
        "tpm_create": true,
        "tpm_enroll": true,
        "enroll_api": "https://enrollsvc.{domain}",
        "enroll_api_cacert": "/ca_default",
        "enroll_api_clientcert": "/cred_enrollclient",
        "enroll_profile": {
            "hostname": "{hostname}",
            "certgen": [ "https-server" ],
            "pkinit-clients": [],
            "realm": "{realm}",
            "days": 1,
            "ktgen": {
                "api": "https://kdc_primary.{domain}"
            },
            "krb5conf": {
                "pkinit_anchors": "/ca_default",
                "domain": "{domain}",
                "dotdomain": ".{domain}",
                "kdchost": "kdc_secondary.{domain}"
            }
        }
    },
    "volumes": [
        "backend",
        "slapd",
        "kdc_primary",
        "kdc_secondary"
    ],
    "principals": [
        "alicia",
        "barton",
        "catarina",
        "healthcheck",
        "iprop/kdc_primary.hcphacking.xyz",
        "iprop/kdc_secondary.hcphacking.xyz",
        "HTTP/kerberos.auth.hcphacking.xyz",
        "host/alicia.hcphacking.xyz",
        "host/barton.hcphacking.xyz",
        "host/catarina.hcphacking.xyz",
        "host/nfs.hcphacking.xyz",
        "host/shell.hcphacking.xyz",
        "nfs/barton.hcphacking.xyz",
        "nfs/catarina.hcphacking.xyz",
        "nfs/nfs.hcphacking.xyz"
    ],
    "fleet": {
        "__default__": {
            "image": "hcp_environment_mit:trixie"
        },
        "orchestrator": {
            "tpm": "none",
            "volumes": [
                "./_crud/testcreds/cred_enrollclient:/cred_enrollclient:ro"
            ],
            "args_for": "orchestrator",
            "result_from": "orchestrator",
            "foreground": "orchestrator",
            "services": { "orchestrator": null }
        },
        "attestsvc": {
            "hostname": "attestsvc.{domain}",
            "tpm": "none",
            "volumes": [
                "backend:/backend",
                "./_crud/testcreds/ca_default_private:/ca_default_private:ro",
                "./_crud/testcreds/ca_httpsclient_private:/ca_httpsclient_private:ro",
                "./_crud/testcreds/cred_attestsvc:/cred_attestsvc:ro",
                "./_crud/testcreds/cred_kdcclient:/cred_kdcclient:ro",
                "./_crud/testcreds/key_attestnoncer:/key_attestnoncer:ro",
                "./_crud/testcreds/signer_asset:/signer_asset:ro"
            ],
            "rootproto": { "attestsvc": null },
            "services": {
                "webapi": {
                    "https_certificate": "/cred_attestsvc"
                }
            }
        },
        "enrollsvc": {
            "hostname": "enrollsvc.{domain}",
            "volumes": [
                "backend:/backend",
                "./_crud/testcreds/ca_enrollsvc:/ca_enrollsvc:ro",
                "./_crud/testcreds/cred_enrollclient:/cred_enrollclient:ro"
            ],
            "rootproto": { "enrollsvc": null },
            "services": {
                "webapi": {
                    "https_authentication": "clientcert",
                    "https_certificate": "/assets/https-server-{hostname}.pem",
                    "https_client_CA": "/ca_enrollsvc",
                    "https_healthclient": "/cred_enrollclient"
                },
                "attester": null
            },
            "env": [ "tpm2tools" ]
        },
        "slapd": {
            "hostname": "slapd.{domain}",
            "volumes": [
                "slapd:/slapd"
            ],
            "services": {
                "attester": null,
                "slapd": null
            },
            "env": [ "tpm2tools", "krb5" ]
        },
        "kdc_primary": {
            "hostname": "kdc_primary.{domain}",
            "image": "hcp_environment_heimdal:trixie",
            "enroll_profile": {
                "certgen": [ "pkinit-kdc", "pkinit-client" ],
                "pkinit-clients": [ "healthcheck" ]
            },
            "volumes": [
                "kdc_primary:/kdc_primary",
                "./_crud/testcreds/ca_kdcsvc:/ca_kdcsvc:ro",
                "./_crud/testcreds/cred_kdcclient:/cred_kdcclient:ro"
            ],
            "rootproto": {
                "kdcsvc": {
                    "secondaries": [ "kdc_secondary.{domain}" ],
                    "pkinit_identity": "/assets/pkinit-kdc-{realm}.pem",
                    "provider": "heimdal"
                }
            },
            "services": {
                "webapi": {
                    "app": "/hcp/kdcsvc/flask_api.py",
                    "https_certificate": "/assets/https-server-{hostname}.pem",
                    "https_authentication": "clientcert",
                    "https_client_CA": "/ca_kdcsvc",
                    "https_healthclient": "/cred_kdcclient"
                },
                "attester": null,
                "kdcsvc_TGS_heimdal": null,
                "kdcsvc_iprop_primary": null
            },
            "env": [ "tpm2tools", "krb5", "kdc_heimdal" ]
        },
        "kdc_secondary": {
            "hostname": "kdc_secondary.{domain}",
            "image": "hcp_environment_heimdal:trixie",
            "enroll_profile": {
                "certgen": [ "pkinit-kdc", "pkinit-iprop", "pkinit-client" ],
                "pkinit-clients": [ "healthcheck" ],
                "krb5conf": { "kdchost": "kdc_primary.{domain}" }
            },
            "volumes": [
                "kdc_secondary:/kdc_secondary",
                "./_crud/testcreds/ca_kdcsvc:/ca_kdcsvc:ro",
                "./_crud/testcreds/cred_kdcclient:/cred_kdcclient:ro"
            ],
            "rootproto": {
                "kdcsvc": {
                    "dir": "/kdc_secondary",
                    "mode": "secondary",
                    "primary": "kdc_primary.{domain}",
                    "pkinit_identity": "/assets/pkinit-kdc-{realm}.pem",
                    "provider": "heimdal"
                }
            },
            "services": {
                "webapi": {
                    "app": "/hcp/kdcsvc/flask_api.py",
                    "https_certificate": "/assets/https-server-{hostname}.pem",
                    "https_authentication": "clientcert",
                    "https_client_CA": "/ca_kdcsvc",
                    "https_healthclient": "/cred_kdcclient"
                },
                "attester": null,
                "kdcsvc_TGS_heimdal": null,
                "kdcsvc_iprop_secondary": null
            },
            "env": [ "tpm2tools", "krb5", "kdc_heimdal" ]
        },
        "kdc_client": {
            "tpm": "none",
            "volumes": [
                "./_crud/testcreds/cred_kdcclient:/cred_kdcclient:ro"
            ],
            "args_for": "kdc_client",
            "result_from": "kdc_client",
            "foreground": "kdc_client",
            "services": { "kdc_client": null }
        },
        "auth_certificate": {
            "hostname": "certificate.auth.{domain}",
            "tpm": "cotenant",
            "volumes": [
                "./_crud/testcreds/ca_httpsclient:/ca_httpsclient:ro",
                "./_crud/testcreds/cred_healthhttpsclient:/cred_healthhttpsclient:ro"
            ],
            "services": {
                "webapi": {
                    "app": "/hcp/python/hcp/flask/dummy.py",
                    "https_certificate": "/assets/https-server-{hostname}.pem",
                    "https_authentication": "clientcert",
                    "https_client_CA": "/ca_httpsclient"
                },
                "attester": null
            },
            "env": [ "tpm2tools", "krb5" ]
        },
        "auth_kerberos": {
            "hostname": "kerberos.auth.{domain}",
            "tpm": "cotenant",
            "enroll_profile": {
                "certgen": [ "pkinit-client" ],
                "pkinit-clients": [ "healthcheck" ],
                "ktgen": {
                    "http": [ "HTTP/{hostname}" ]
                }
            },
            "services": {
                "webapi": {
                    "app": "/hcp/python/hcp/flask/dummy.py",
                    "https_certificate": "/assets/https-server-{hostname}.pem",
                    "https_authentication": "kerberos"
                },
                "attester": null
            },
            "env": [ "tpm2tools", "krb5", "httpskrb5" ]
        },
        "shell": {
            "hostname": "shell.{domain}",
            "enroll_profile": {
                "ktgen": {
                    "sshd": [ "host/{hostname}" ]
                }
            },
            "services": {
                "attester": null,
                "sshd": null
            },
            "env": [ "tpm2tools", "krb5", "sshd" ]
        },
        "nfs": {
            "hostname": "nfs.{domain}",
            "tpm": "cotenant",
            "vm": "qemu_mit",
            "volumes": [ "./_crud:/crud:ro" ],
            "enroll_profile": {
                "ktgen": {
                    "nfsd": [ "host/{hostname}", "nfs/{hostname}" ]
                }
            },
            "services": {
                "attester": null,
                "nfsd": {
                    "exports": [
                        "/home *(rw,sync,no_subtree_check,sec=krb5p,fsid=0,insecure)"
                    ]
                },
                "sshd": null
            },
            "env": [ "tpm2tools", "krb5", "nfsd" ]
        },
        "bigbrother": {
            "hostname": "bigbrother.{domain}",
            "enroll_profile": {
                "certgen": [ "pkinit-client", "https-client" ],
                "pkinit-clients": [ "root" ],
                "https-clients": [ "root" ],
                "ktgen": {
                    "sshd": [ "host/{hostname}" ]
                }
            },
            "services": {
                "attester": null,
                "sshd": null
            },
            "env": [ "tpm2tools", "krb5", "sshd" ]
        },
        "alicia": {
            "hostname": "alicia.{domain}",
            "tpm": "cotenant",
            "enroll_profile": {
                "certgen": [ "pkinit-client", "https-client" ],
                "pkinit-clients": [ "alicia" ],
                "https-clients": [ "alicia", "boz" ],
                "ktgen": {
                    "sshd": [ "host/{hostname}" ]
                }
            },
            "services": {
                "attester": null,
                "sshd": null
            },
            "env": [ "tpm2tools", "krb5", "sshd" ]
        },
        "barton": {
            "hostname": "barton.{domain}",
            "tpm": "cotenant",
            "vm": "qemu_heimdal",
            "volumes": [ "./_crud:/crud:ro" ],
            "enroll_profile": {
                "certgen": [ "pkinit-client", "https-client" ],
                "pkinit-clients": [ "barton", "catarina" ],
                "ktgen": {
                    "sshd": [ "host/{hostname}", "nfs/{hostname}" ]
                }
            },
            "services": {
                "attester": null,
                "sshd": null,
                "mounter": {
                    "mounts": {
                        "/home": "nfs.hcphacking.xyz:/"
                    }
                }
            },
            "env": [ "tpm2tools", "krb5", "sshd" ]
        },
        "catarina": {
            "hostname": "catarina.{domain}",
            "tpm": "cotenant",
            "vm": "uml_heimdal",
            "volumes": [ "./_crud:/crud:ro" ],
            "enroll_profile": {
                "certgen": [ "pkinit-client", "https-client" ],
                "pkinit-clients": [ "catarina", "barton" ],
                "ktgen": {
                    "sshd": [ "host/{hostname}", "nfs/{hostname}" ]
                }
            },
            "services": {
                "attester": null,
                "sshd": null,
                "mounter": {
                    "mounts": {
                        "/home": "nfs.hcphacking.xyz:/"
                    }
                }
            },
            "env": [ "tpm2tools", "krb5", "sshd" ]
        },
        "hostside": {
            "hostname": "hostside.{domain}",
            "tpm": "unmanaged",
            "volumes": [
                "./_crud/testcreds/cred_enrollclient:/cred_enrollclient:ro"
            ],
            "devices": [
                "/dev/tpmrm0:/dev/tpmrm0"
            ],
            "enroll_profile": {
                "ktgen": {
                    "sshd": [ "host/{hostname}" ]
                }
            },
            "services": {
                "attester": {
                    "dictionarylockout": false
                },
                "sshd": null
            },
            "env": [ "krb5", "sshd" ]
        }
    }
}
